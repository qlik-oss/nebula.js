{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": { "outputs": ["$TURBO_EXTENDS$", "core/esm/**"] },
    "build:dev": { "outputs": ["$TURBO_EXTENDS$", "core/esm/**"] },
    "spec": {
      "dependsOn": ["transit"],
      "outputs": ["api-spec/spec.json", "api-spec/listbox-spec.json"]
    },
    "ts": {
      "dependsOn": ["spec"],
      "outputs": ["types/index.d.ts"]
    }
  }
}
