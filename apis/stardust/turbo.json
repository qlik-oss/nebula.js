{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/rslib.mjs", "$TURBO_ROOT$/tools/locale-string-validator.cjs"],
      "outputs": ["$TURBO_EXTENDS$", "core/esm/**"]
    },
    "build:dev": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/rslib.mjs", "$TURBO_ROOT$/tools/locale-string-validator.cjs"],
      "outputs": ["$TURBO_EXTENDS$", "core/esm/**"]
    },
    "spec": {
      "dependsOn": ["transit"],
      "outputs": ["api-spec/spec.json", "api-spec/listbox-spec.json"]
    },
    "ts": {
      "dependsOn": ["spec"],
      "outputs": ["types/index.d.ts"]
    }
  }
}
