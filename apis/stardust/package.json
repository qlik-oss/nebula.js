{
  "name": "@nebula.js/stardust",
  "version": "8.0.0-alpha.4",
  "description": "Product and framework agnostic integration API for Qlik's Associative Engine",
  "license": "MIT",
  "author": "QlikTech International AB",
  "keywords": [
    "qlik",
    "qix",
    "sense",
    "nebula",
    "stardust"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qlik-oss/nebula.js.git",
    "directory": "apis/stardust"
  },
  "main": "dist/stardust.esm.js",
  "types": "types/index.d.ts",
  "files": [
    "LICENSE",
    "core",
    "dist",
    "types/index.d.ts"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production rslib build",
    "build:dev": "rslib build",
    "build:watch": "rslib build --watch",
    "prepublishOnly": "rm -rf dist && pnpm run build",
    "spec:stardust": "sy from-jsdoc -c ./api-spec/spec.conf.cjs",
    "spec:listbox": "sy from-jsdoc -c ./api-spec/listbox-spec.conf.cjs",
    "spec": "pnpm run spec:stardust && pnpm run spec:listbox",
    "ts": "sy to-dts -c ./api-spec/spec.conf.cjs",
    "version": "pnpm run spec && pnpm run ts && git add ./api-spec/spec.json ./api-spec/listbox-spec.json ./types/index.d.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@nebula.js/conversion": "workspace:*",
    "@nebula.js/enigma-mocker": "workspace:*",
    "@nebula.js/locale": "workspace:*",
    "@nebula.js/nucleus": "workspace:*",
    "@nebula.js/supernova": "workspace:*",
    "@nebula.js/theme": "workspace:*",
    "@nebula.js/ui": "workspace:*",
    "@qlik/api": "2.21.0",
    "@rslib/core": "1.0.5",
    "@scriptappy/cli": "0.10.6",
    "@scriptappy/from-jsdoc": "0.19.6",
    "@scriptappy/to-dts": "1.0.4",
    "cross-env": "10.1.0",
    "extend": "3.0.2",
    "node-event-emitter": "0.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-test-renderer": "19.3.1",
    "react-virtualized-auto-sizer": "1.0.25",
    "react-window": "1.8.11",
    "react-window-infinite-loader": "1.0.10",
    "regenerator-runtime": "0.14.1",
    "semver": "7.8.5"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "development": "./dist/stardust.esm.dev.js",
      "default": "./dist/stardust.esm.js"
    },
    "./core": {
      "development": "./core/esm/dev.js",
      "default": "./core/esm/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
