{
  "name": "@nebula.js/stardust",
  "version": "7.3.0",
  "description": "Product and framework agnostic integration API for Qlik's Associative Engine",
  "license": "MIT",
  "author": "QlikTech International AB",
  "keywords": [
    "qlik",
    "qix",
    "sense",
    "nebula",
    "stardust"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qlik-oss/nebula.js.git",
    "directory": "apis/stardust"
  },
  "main": "index.js",
  "jsdelivr": "dist/stardust.js",
  "unpkg": "dist/stardust.js",
  "types": "types/index.d.ts",
  "files": [
    "LICENSE",
    "core",
    "dist",
    "types/index.d.ts"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup --bundleConfigAsCjs --config ../../rollup.config.js",
    "build:dev": "rollup --bundleConfigAsCjs --config ../../rollup.config.js",
    "build:watch": "rollup --bundleConfigAsCjs --config ../../rollup.config.js -w",
    "prepublishOnly": "rm -rf dist && pnpm run build",
    "spec:stardust": "sy from-jsdoc -c ./api-spec/spec.conf.js",
    "spec:listbox": "sy from-jsdoc -c ./api-spec/listbox-spec.conf.js",
    "spec": "pnpm run spec:stardust && pnpm run spec:listbox",
    "ts": "sy to-dts -c ./api-spec/spec.conf.js",
    "version": "pnpm run spec && pnpm run ts && git add ./api-spec/spec.json ./api-spec/listbox-spec.json ./types/index.d.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@nebula.js/conversion": "workspace:*",
    "@nebula.js/enigma-mocker": "workspace:*",
    "@nebula.js/locale": "workspace:*",
    "@nebula.js/nucleus": "workspace:*",
    "@nebula.js/supernova": "workspace:*",
    "@nebula.js/theme": "workspace:*",
    "@nebula.js/ui": "workspace:*",
    "@qlik/api": "2.14.1",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@scriptappy/cli": "0.10.6",
    "@scriptappy/from-jsdoc": "0.19.6",
    "@scriptappy/to-dts": "1.0.4",
    "cross-env": "10.1.0",
    "extend": "3.0.2",
    "node-event-emitter": "0.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-test-renderer": "19.2.8",
    "react-virtualized-auto-sizer": "1.0.25",
    "react-window": "1.8.11",
    "react-window-infinite-loader": "1.0.10",
    "regenerator-runtime": "0.14.1",
    "rollup": "4.62.3",
    "semver": "7.8.5"
  }
}
