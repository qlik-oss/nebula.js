{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["babel.config.cjs", "rollup.config.js", "pnpm-workspace.yaml"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev", "transit"],
      "outputs": ["dist/**"]
    },
    "build:watch": {
      "dependsOn": ["^build:dev"],
      "cache": false,
      "persistent": true
    },
    "//#eslint": {
      "dependsOn": [
        "@nebula.js/locale#build",
        "@nebula.js/snapshooter#build",
        "@nebula.js/stardust#build",
        "@nebula.js/test-utils#build"
      ],
      "cache": false
    },
    "//#jest": {
      "dependsOn": ["@nebula.js/locale#build", "@nebula.js/stardust#build", "@nebula.js/test-utils#build"],
      "passThroughEnv": ["JEST_JUNIT_OUTPUT_DIR"],
      "cache": false
    }
  }
}
