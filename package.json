{
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production pnpm -r --sequential run build",
    "build:dev": "cross-env NODE_ENV=development pnpm -r run build",
    "build:watch": "pnpm -r --parallel run build:watch ",
    "format": "prettier --write '**/**/*' --ignore-unknown",
    "format:check": "prettier --check '**/**/*' --ignore-unknown",
    "locale:verify": "node tools/verify-translations.cjs",
    "locale:generate": "pnpm -r locale:generate",
    "lint": "eslint packages apis commands --ext .js,.jsx",
    "spec": "pnpm -r --sequential run spec && pnpm -r --sequential run ts",
    "mashup": "node scripts/start-mashup.js",
    "test": "pnpm run test:unit",
    "test:unit": "jest --maxWorkers=2",
    "test:update": "jest --maxWorkers=2 -u",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mashup": "playwright test test/mashup --config=./test/mashup/playwright.config.mashup.js",
    "test:rendering": "playwright test --config=./test/rendering/playwright.config.rendering.js --quiet",
    "test:integration": "playwright test test/integration",
    "test:component": "playwright test test/component",
    "test:visual": "playwright test --config=./commands/serve/test/playwright.config.js",
    "test:visual:update": "playwright test --config=./commands/serve/test/playwright.config.js --update-snapshots",
    "test:visual:update-missing": "playwright test --config=./commands/serve/test/playwright.config.js --update-snapshots=missing",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qlik-oss/nebula.js.git"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint",
      "prettier"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "babel-plugin-istanbul": "8.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mocha": "12.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.8.0",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "jest-location-mock": "^4.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "whatwg-fetch": "^3.6.20"
  },
  "resolutions": {
    "dts-dom": "3.7.0",
    "caniuse-lite": "1.0.30001806",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "@playwright/test": "^1.62.0",
    "minimatch@npm:^3.0.0": "^10.2.6",
    "minimatch@npm:^5.0.0": "^10.2.6",
    "minimatch@npm:^9.0.0": "^10.2.6",
    "minimatch@npm:^10.0.0": "^10.2.6",
    "tar@npm:^7.0.0": "^7.5.22",
    "glob@npm:^10.0.0": "^13.0.6",
    "glob@npm:^11.0.0": "^13.0.6"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
