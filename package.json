{
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:watch": "turbo run build:watch",
    "format": "prettier --write '**/**/*' --ignore-unknown",
    "format:check": "prettier --check '**/**/*' --ignore-unknown",
    "locale:verify": "turbo run locale:verify",
    "locale:generate": "turbo run locale:generate",
    "lint": "turbo run //#eslint",
    "eslint": "eslint packages apis commands --ext .js,.jsx",
    "spec": "turbo run spec ts",
    "mashup": "node scripts/start-mashup.js",
    "test": "pnpm run test:unit",
    "test:unit": "turbo run //#jest //#test:tools",
    "test:coverage": "turbo run //#jest:coverage //#test:tools",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "jest": "jest --maxWorkers=2",
    "jest:coverage": "jest --maxWorkers=2 --coverage",
    "test:update": "jest --maxWorkers=2 -u",
    "test:watch": "jest --watch",
    "test:mashup": "playwright test test/mashup --config=./test/mashup/playwright.config.mashup.js",
    "test:rendering": "playwright test --config=./test/rendering/playwright.config.rendering.js --quiet",
    "test:integration": "playwright test test/integration",
    "test:component": "playwright test test/component",
    "test:visual": "playwright test --config=./commands/serve/test/playwright.config.js",
    "test:visual:update": "playwright test --config=./commands/serve/test/playwright.config.js --update-snapshots",
    "test:visual:update-missing": "playwright test --config=./commands/serve/test/playwright.config.js --update-snapshots=missing",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qlik-oss/nebula.js.git"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint",
      "prettier"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/helper-plugin-utils": "8.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "babel-plugin-istanbul": "8.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-location-mock": "^4.0.1",
    "lerna": "9.0.7",
    "lint-staged": "^17.6.0",
    "magic-string": "0.30.21",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "rollup": "4.64.12",
    "turbo": "2.11.10",
    "whatwg-fetch": "^3.6.20"
  },
  "resolutions": {
    "dts-dom": "3.7.0",
    "caniuse-lite": "1.0.30001818",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "@playwright/test": "^1.64.1",
    "minimatch@npm:^3.0.0": "^10.2.6",
    "minimatch@npm:^5.0.0": "^10.2.6",
    "minimatch@npm:^9.0.0": "^10.2.6",
    "minimatch@npm:^10.0.0": "^10.2.6",
    "tar@npm:^7.0.0": "^7.5.22",
    "glob@npm:^10.0.0": "^13.0.6",
    "glob@npm:^11.0.0": "^13.0.6"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
